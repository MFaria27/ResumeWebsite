{
	"name": "resweb",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"css-build": "sass --no-source-map ./static/scss/bulma.scss ./static/css/bulma.css",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d build --dotfiles",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.1",
		"@tsconfig/svelte": "^5.0.2",
		"bulma": "^0.9.4",
		"gh-pages": "^6.1.1",
		"sass": "^1.70.0",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.3",
		"vite": "^5.2.8"
	},
	"type": "module"
}
